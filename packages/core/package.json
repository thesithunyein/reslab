{
  "name": "@reslab/core",
  "version": "0.1.0",
  "description": "ResLab core engine: statistics with hard verification, tamper-evident audit log, pre-registration, and p-hacking detection.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
